<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permissions for Supabase live database connection -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".HijabKuApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HijabKu"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Splash Screen (Launcher) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.HijabKu.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Login & Register -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.login.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Activity (Hosts Bottom Nav: Home, Kategori, Keranjang, Pesanan, Akun) -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false" />

        <!-- Product List Pashmina -->
        <activity
            android:name=".ui.product.ProductListActivity"
            android:exported="false" />

        <!-- Product Detail -->
        <activity
            android:name=".ui.product.ProductDetailActivity"
            android:exported="false" />

        <!-- Checkout -->
        <activity
            android:name=".ui.checkout.CheckoutActivity"
            android:exported="false" />

        <!-- Payment Instruction & Sandbox -->
        <activity
            android:name=".ui.payment.PaymentInstructionActivity"
            android:exported="false" />

        <!-- Order Tracking -->
        <activity
            android:name=".ui.order.OrderTrackingActivity"
            android:exported="false" />

        <!-- Product Review -->
        <activity
            android:name=".ui.review.ProductReviewActivity"
            android:exported="false" />

    </application>

</manifest>
