<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="72dp">

        <!-- Title Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:text="Kategori"
                android:textColor="@color/primary_container"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_count_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="5 Koleksi Utama"
                android:textColor="@color/on_secondary_container"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Eksplorasi ragam pilihan hijab premium dan pelengkap santun Anda."
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp" />

        <!-- Search Bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/etCategorySearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_search_pill"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:hint="Cari kategori atau jenis kain..."
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline"
                android:textSize="12sp" />
        </FrameLayout>

        <!-- Category Items RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategoryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:nestedScrollingEnabled="false"
            tools:itemCount="5"
            tools:listitem="@layout/item_category_card" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
